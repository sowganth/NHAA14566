# SVI Engine Configuration Environment Variables
APP_NAME=NHAA-SVI-Engine
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0

# Security
API_KEY_REQUIRED=false
API_KEYS=["demo-team1-key-14566","demo-team3-key-14566","admin-key-secure"]

# Database
# If DATABASE_URL is empty or sqlite, SQLite will be used for local testing.
# For PostgreSQL: postgresql://svi_user:svi_secret@localhost:5432/svi_db
DATABASE_URL=sqlite:///./svi_assessment.db

# Scoring Configuration Path
SCORING_CONFIG_PATH=./config/scoring.yaml

# Logging
LOG_LEVEL=INFO
