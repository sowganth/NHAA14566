# National Helpline Against Atrocities (NHAA 14566) Configuration

# API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./data/app.db

# Security & CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
SECRET_KEY=nhaa-super-secret-key-change-in-production

# AI / NLP Settings
NLP_CONFIDENCE_THRESHOLD=0.75
SVI_HIGH_RISK_THRESHOLD=0.70
SVI_CRITICAL_RISK_THRESHOLD=0.85
SAFETY_OVERRIDE_ENABLED=true

# Frontend API URL (for Vite build)
VITE_API_BASE_URL=http://localhost:8000
