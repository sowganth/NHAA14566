# National Helpline Against Atrocities (NHAA 14566) Configuration
# Copy this file to ".env" (never commit the real .env) and restart the backend.

# API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./data/app.db

# Security & CORS
# Must be valid JSON: double quotes, no trailing comma, no trailing slashes.
# Add your Vercel URL(s). Do NOT list the backend's own address here.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","https://frontend-six-dun-tlumuee4ec.vercel.app"]

# Generate a real value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# AI / NLP Settings
NLP_CONFIDENCE_THRESHOLD=0.75
SVI_HIGH_RISK_THRESHOLD=0.70
SVI_CRITICAL_RISK_THRESHOLD=0.85
SAFETY_OVERRIDE_ENABLED=true

# Frontend API URL (read by Vite at BUILD time, not by the backend).
# Local dev:            http://localhost:8000
# Demo via tunnel:      https://<your-tunnel>.trycloudflare.com
# Production (Render):  https://<your-service>.onrender.com
# On Vercel, set this in Project > Settings > Environment Variables, then redeploy.
VITE_API_BASE_URL=http://localhost:8000